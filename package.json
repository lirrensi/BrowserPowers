{
  "name": "browserpowers",
  "version": "1.6.0",
  "private": false,
  "workspaces": [
    "core",
    "extension"
  ],
  "author": "lirrensi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lirrensi/BrowserPowers.git"
  },
  "bugs": {
    "url": "https://github.com/lirrensi/BrowserPowers/issues"
  },
  "homepage": "https://github.com/lirrensi/BrowserPowers#readme",
  "keywords": [
    "browser-automation",
    "llm",
    "ai-agent",
    "multi-browser",
    "mcp"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present --parallel",
    "dev:core": "npm run dev -w browserpowers",
    "dev:ext": "npm run dev -w browserpowers-extension",
    "dev:ext:chrome": "npm run dev:chrome -w browserpowers-extension",
    "dev:ext:firefox": "npm run dev:firefox -w browserpowers-extension",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "predev": "npm run build",
    "prepare": "npm run prepare -w browserpowers-extension",
    "clean": "npm run clean --workspaces --if-present",
    "test:core": "vitest run --project core",
    "test:ext": "vitest run --project extension",
    "test:manual": "node manual-tests/run-all.mjs",
    "smoke": "node manual-tests/test-smoke.mjs",
    "eval": "node evals/browser/cli.mjs validate",
    "eval:list": "node evals/browser/cli.mjs list",
    "eval:coverage": "node evals/browser/cli.mjs coverage",
    "eval:smoke": "node evals/browser/cli.mjs smoke",
    "test:safe": "node scripts/test-safe.mjs",
    "test:live": "node scripts/test-live.mjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
